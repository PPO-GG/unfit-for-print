# ──── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://unfit:unfit@localhost:5432/unfit

# ──── Session / auth secrets (server-only) ─────────────────────────
# Random 32+ char secrets. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
NUXT_ACTIVITY_TOKEN_SECRET=

# ──── Discord OAuth2 / Activity (server-only) ──────────────────────
NUXT_DISCORD_CLIENT_SECRET=
NUXT_DISCORD_PUBLIC_KEY=
NUXT_DISCORD_APPLICATION_ID=

# ──── Discord OAuth2 / Activity (public — bundled into client JS) ──
NUXT_PUBLIC_DISCORD_CLIENT_ID=

# ──── Cloudflare R2 (decoration image storage, server-only) ────────
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=decoration-images

# ──── External services (server-only) ───────────────────────────────
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=

# ──── App (public — bundled into client JS) ────────────────────────
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# Yjs lobby Teleportal server (public — bundled into client JS)
NUXT_PUBLIC_LOBBY_TELEPORTAL_URL=wss://teleportal.unfit.cards
